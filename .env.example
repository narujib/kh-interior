# Environment Variables Template — Khakim Interior
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit .env.local to version control.

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Pooled connection — used by the runtime application
DATABASE_URL=

# Direct connection — used by Prisma CLI (migrations, seed)
DIRECT_URL=

# ─── Auth.js / NextAuth ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ─── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
